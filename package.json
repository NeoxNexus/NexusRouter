{
  "name": "nexusrouter",
  "version": "0.12.8",
  "description": "Smart LLM router — local hybrid classifier (rules + heuristics + optional AI) routes each request to the right model tier. 41+ models priced, zero-cost routing in <1ms.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nexusrouter": "./dist/cli.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pack": "pnpm build && pnpm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "load-test": "tsx scripts/load-test.ts"
  },
  "keywords": [
    "llm",
    "router",
    "smart-routing",
    "ai",
    "cost-optimization",
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "nexusrouter",
    "model-router",
    "new-api"
  ],
  "author": "NexusRouter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neo/NexusRouter.git"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "yaml": "^2.0.0",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2025.1.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "openclaw": "latest",
    "prettier": "3.8.1",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
